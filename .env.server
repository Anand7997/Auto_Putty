# Server Environment Configuration
# Use this for server deployment at 10.30.3.85
# Frontend: http://10.30.3.85:8081/
# Backend: http://10.30.3.85:5000/

# Backend API URL for server deployment
VITE_API_BASE_URL=http://10.30.3.85:5000

# Environment identifier
# Note: NODE_ENV=production is handled by Vite config, not in .env files
VITE_ENV=server

# Server deployment settings
VITE_DEV_MODE=false
VITE_DEBUG=false
